  "segments": [
    {
      "segment_id": "golden_001",
      "text": "アップデートが良くなるんかな。",
      "timestamps": {
        "from": "00:00:11.690",
        "to": "00:00:16.950"
      }
    },
    {
      "segment_id": "golden_002",
      "text": "なんか一7のところ開いてみたら、アップデートってあったから、アップデートは押してみた。",
      "timestamps": {
        "from": "00:00:16.950",
        "to": "00:00:24.870"
      }
    },
    {
      "segment_id": "golden_003",
      "text": "でも、Wi Fi とかは別に何にも。",
      "timestamps": {
        "from": "00:00:24.870",
        "to": "00:00:27.860"
      }
    },
    {
      "segment_id": "golden_004",
      "text": "あのルーターとかも再起動させてないし。",
      "timestamps": {
        "from": "00:00:27.860",
        "to": "00:00:31.840"
      }
    },
    {
      "segment_id": "golden_005",
      "text": "てかね、私のね。",
      "timestamps": {
        "from": "00:00:31.840",
        "to": "00:00:35.770"
      }
    },
    {
      "segment_id": "golden_006",
      "text": "家のワイファイねマンションで契約してるやつやねやんか",
      "timestamps": {
        "from": "00:00:35.770",
        "to": "00:00:40.990"
      }
    },
    {
      "segment_id": "golden_007",
      "text": "だからさ、これ以上さ、良くなりようがないね・けど。",
      "timestamps": {
        "from": "00:00:40.990",
        "to": "00:00:46.640"
      }
    },
    {
      "segment_id": "golden_008",
      "text": "一番いいワイファイやもんマンションの。",
      "timestamps": {
        "from": "00:00:46.640",
        "to": "00:00:53.230"
      }
    },
    {
      "segment_id": "golden_009",
      "text": "ひどいやな。",
      "timestamps": {
        "from": "00:00:53.230",
        "to": "00:00:55.710"
      }
    },
    {
      "segment_id": "golden_010",
      "text": "これでいけたらいいけど。",
      "timestamps": {
        "from": "00:00:55.710",
        "to": "00:00:59.050"
      }
    },
    {
      "segment_id": "golden_011",
      "text": "コスさん、来てくれてありがとう。こんにちは。みんなね、月のギフティング人数をね、集めてます。",
      "timestamps": {
        "from": "00:00:59.050",
        "to": "00:01:00.000"
      }
    }
  ]
